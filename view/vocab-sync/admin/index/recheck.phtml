// // Link to the resource's admin page · Omeka's `id` route is
// // /:controller/:id[/:action] under /admin (as routes.config.php says)
// // · when the kind of resource is not known, the number alone beats a broken link.
$resourceLink = function ($id) use ($resourceTypes) {
    $id = (int) $id;
    if (!isset($resourceTypes[$id])) {
        return '#' . $id;
    }
    $url = $this->url('admin/id', ['controller' => $resourceTypes[$id], 'id' => $id]);
    return sprintf(
        '<a href="%s" target="_blank" rel="noopener">#%d <span class="vs-ext">&#8599;</span></a>',
        $this->escapeHtmlAttr($url),
        $id
    );
};
?>
