        <div class="inputs">
            <select id="old_vocab_id" name="old_vocab_id" required>
                <option value=""></option>
                <?php foreach ($offer as $v): ?>
                <option value="<?php echo (int) $v['id']; ?>">
                    <?php echo $this->escapeHtml($v['label']); ?>
                    — <?php echo count(json_decode($v['terms'], true) ?: []); ?> terms
