<?php
$resourceLink = function ($id) use ($resourceTypes) {
    $id = (int) $id;
    if (!isset($resourceTypes[$id])) {
        return '#' . $id;
    }
    $url = $this->url('admin/id', ['controller' => $resourceTypes[$id], 'id' => $id]);
    return sprintf(
        '<a href="%s" target="_blank" rel="noopener">#%d <span class="vs-ext">&#8599;</span></a>',
        $this->escapeHtmlAttr($url),
        $id
    );
};
?>

    <div class="vs-actions">
        <a href="<?php echo $this->url('admin/vocab-sync', ['action' => 'edit-vocab', 'id' => $newVocabId]); ?>" class="button">
