                </a>
            <?php endforeach; ?>
        </li>
        <?php endforeach; ?>
    </ul>
    <p>
        <?php if ($showAll): ?>
        They are included in the list below. Importing again creates a second
        vocabulary holding the same terms.
        <?php else: ?>
        They are hidden from the list below.
        <a href="<?php echo $this->url('admin/vocab-sync', ['action' => 'import']); ?>?show_all=1">Show them anyway</a>
        — useful if you deleted the imported vocabulary and want to start over.
        <?php endif; ?>
    </p>
</div>
<?php endif; ?>

