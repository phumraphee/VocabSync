<?php
$fresh = [];
$done = [];
foreach ($oldVocabs as $v) {
    if (isset($importedInto[(int) $v['id']])) {
        $done[] = $v;
    } else {
        $fresh[] = $v;
    }
}
$offer = $showAll ? $oldVocabs : $fresh;
?>

<?php if ($done): ?>
<div class="vs-note">
    <span class="vs-callout-title">
        <?php echo count($done); ?>
        <?php echo (count($done) === 1) ? 'vocabulary is' : 'vocabularies are'; ?>
        already imported
    </span>
    <ul>
        <?php foreach ($done as $v): ?>
        <li>
            <?php echo $this->escapeHtml($v['label']); ?> —
            <?php foreach ($importedInto[(int) $v['id']] as $i => $target): ?>
