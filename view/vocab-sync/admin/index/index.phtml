    if (empty($v['owner_name'])) { $anyUnowned = true; break; }
}
?>
<?php if ($anyUnowned): ?>
<div class="vs-note">
    Some vocabularies say <strong>not recorded</strong> under “Added by”. They were
    made before the module started keeping that, and there is no other source to
