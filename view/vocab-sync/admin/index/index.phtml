            <th>Added by</th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($vocabs as $v): ?>
        <?php $used = $valueCounts['vocabsync:' . (int) $v['id']] ?? 0; ?>
        <tr>
            <td>
                <a href="<?php echo $this->url('admin/vocab-sync', ['action' => 'edit-vocab', 'id' => $v['id']]); ?>">
                    <?php echo $this->escapeHtml($v['label']); ?>
                </a>
            </td>
            <td><code class="vs-datatype">vocabsync:<?php echo (int) $v['id']; ?></code></td>
            <td>
                <?php echo (int) $v['active_count']; ?> active
                <span class="vs-muted">of <?php echo (int) $v['term_count']; ?> total</span>
            </td>
            <td>
                <?php if ($used > 0): ?>
                    <?php echo number_format($used); ?>
                <?php else: ?>
                    <span class="vs-muted">none</span>
                <?php endif; ?>
            </td>
            <td>
                <?php if (!empty($v['owner_name'])): ?>
                    <?php echo $this->escapeHtml($v['owner_name']); ?>
